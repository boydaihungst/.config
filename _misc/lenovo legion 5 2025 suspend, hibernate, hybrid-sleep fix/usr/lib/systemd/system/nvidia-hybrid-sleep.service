[Unit]
Description=NVIDIA actions for hybrid sleep
Before=systemd-hybrid-sleep.service

[Service]
Type=oneshot
ExecStart=/usr/bin/logger -t suspend -s "nvidia-hybrid-sleep.service"
ExecStart=/usr/bin/nvidia-sleep.sh "is-suspend-then-hibernate-supported"
ExecStart=/usr/bin/nvidia-sleep.sh "hibernate"

[Install]
WantedBy=systemd-hybrid-sleep.service
