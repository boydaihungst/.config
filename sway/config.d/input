### Input configuration
#
# Read `man 5 sway-input` for more information about this section.

# Touchpad configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    scroll_factor 1.0
    events disabled_on_external_mouse
    scroll_method two_finger
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}

# Enable numlock by default
input type:keyboard {
    xkb_numlock enabled
    repeat_rate 80
    repeat_delay 300
}

input 9390:4629:Rapoo_Rapoo_Gaming_Device {
    scroll_factor 2
    accel_profile flat
}

