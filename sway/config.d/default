# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Add Vim key support
set $left h
set $down j
set $up k
set $right l

set $terminal kitty
set $browser vivaldi
set $powermenu ~/.config/rofi/powermenu/type-2/powermenu.sh
set $applaucher ~/.config/rofi/launchers/type-1/launcher.sh
set $powerprofiles ~/.config/sway/scripts/power-profiles
set $volumectl ~/.config/sway/scripts/volumectl
set $brightnesschange ~/.config/sway/scripts/brightness-change.sh
set $toggle_gemini ~/.config/sway/scripts/toggle_gemini.sh

### Key bindings
#
# Basics:
#
    # Launch the terminal
    bindsym $mod+Return exec $terminal

    # Open the power menu
    bindsym $mod+x exec $powermenu

    # Open the power menu
    bindsym $mod+Shift+p exec $powerprofiles

    # Kill focused window
    bindsym $mod+q kill

    # Start your applaucher
    bindsym $mod+d exec $applaucher

    # Move windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Change "normal" to "inverse" to switch left and right
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

#
# Moving around:
#
    bindsym {
        # Change window focus
        $mod+$left focus left
        $mod+$down focus down
        $mod+$up focus up
        $mod+$right focus right

        # Move the focused window
        $mod+Shift+Left move left
        $mod+Shift+Down move down
        $mod+Shift+Up move up
        $mod+Shift+Right move right
        # Vim key support
        $mod+Shift+$left move left
        $mod+Shift+$down move down
        $mod+Shift+$up move up
        $mod+Shift+$right move right
        # Move focused window to the monitor in the specified direction
        $mod+Left move container to output left
        $mod+Right move container to output right
        $mod+Up move container to output up
        $mod+Down move container to output down
        # Switch to the next/previous workspace on the current monitor
        $mod+Tab workspace next_on_output
        $mod+Shift+Tab workspace prev_on_output
    }

#
# Workspaces:
#
    # Workspace bindings are using bindcode instead of bindsym for better Azerty compatibility.
    # https://github.com/EndeavourOS-Community-Editions/sway/pull/81
    # Use wev to find keycodes for setting up other bindings this way.

    bindcode {
        # Switch to workspace
        $mod+10 workspace number 1
        $mod+11 workspace number 2
        $mod+12 workspace number 3
        $mod+13 workspace number 4
        $mod+14 workspace number 5
        $mod+15 workspace number 6
        $mod+16 workspace number 7
        $mod+17 workspace number 8
        $mod+18 workspace number 9
        $mod+19 workspace number 10

        # Move focused container to workspace
        $mod+Shift+10 move container to workspace number 1
        $mod+Shift+11 move container to workspace number 2
        $mod+Shift+12 move container to workspace number 3
        $mod+Shift+13 move container to workspace number 4
        $mod+Shift+14 move container to workspace number 5
        $mod+Shift+15 move container to workspace number 6
        $mod+Shift+16 move container to workspace number 7
        $mod+Shift+17 move container to workspace number 8
        $mod+Shift+18 move container to workspace number 9
        $mod+Shift+19 move container to workspace number 10
    }
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

#
# Layout stuff:
#
    # Set how the current window will be split
    # Split the window vertically
    # bindsym $mod+v splitv
    # Split the window horizontally
    # bindsym $mod+Minus splith

    # Switch the current container between different layout styles
    # bindsym $mod+s layout stacking
    # bindsym $mod+w layout tabbed

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle between tiling and floating mode
    bindsym $mod+Shift+f floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent

#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show

#
# Resizing containers:
#
    mode "Resize" {
        bindsym {
            # Resize with arrow keys
            $mod+ctrl+Right resize shrink width 50 px
            $mod+ctrl+Up resize grow height 50 px
            $mod+ctrl+Down resize shrink height 50 px
            $mod+ctrl+Left resize grow width 50 px
            # Resize with Vim keys
            $mod+ctrl+$right resize shrink width 50 px
            $mod+ctrl+$up resize grow height 50 px
            $mod+ctrl+$down resize shrink height 50 px
            $mod+ctrl+$left resize grow width 50 px
            # Exit resize mode
            Escape mode "default"
            Return mode "default"
        }
    }

    # Resize floating windows with mouse scroll:
    # bindsym --whole-window --border {
    #     # Resize vertically
    #     $mod+button4 resize shrink height 5 px or 5 ppt
    #     $mod+button5 resize grow height 5 px or 5 ppt
    #     # Resize horizontally
    #     $mod+Shift+button4 resize shrink width 5 px or 5 ppt
    #     $mod+Shift+button5 resize grow width 5 px or 5 ppt
    # }

#
# Media Keys
#
    bindsym {
        # Volume
        XF86AudioRaiseVolume exec $volumectl --volume-step 1 up
        XF86AudioLowerVolume exec $volumectl --volume-step 1 down
        XF86AudioMute exec $volumectl togmute

        # Player
        XF86AudioPlay exec playerctl play-pause
        XF86AudioNext exec playerctl next
        XF86AudioPrev exec playerctl previous
        XF86AudioStop exec playerctl stop
        XF86AudioPause exec playerctl pause
        XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        XF86WLAN exec nmcli radio wifi toggle

        # Backlight
        XF86MonBrightnessUp exec $brightnesschange 5%+
        XF86MonBrightnessDown exec $brightnesschange 5%-

        # Touchpad
        XF86TouchpadOff input "type:touchpad" events disabled
        XF86TouchpadOn input "type:touchpad" events enabled
        XF86Calculator exec speedcrunch

        # Lenovo Legion 5 copilot AI button
        $mod+Shift+XF86TouchpadOff exec $toggle_gemini
    }

#
# App shortcuts
#
    # Launch the file explorer
    bindsym $mod+n exec $terminal --app-id 'yazi' -- yazi
    bindsym $mod+Shift+n exec YAZI_LOG=debug $terminal --app-id 'yazi' -- yazi

    # Launch the text editor
    bindsym $mod+e exec $terminal --app-id 'nvim' -- nvim

    # Launch the browser
    bindsym $mod+w exec $browser

    # Launch color picker
    bindsym $mod+z exec hyprpicker -a -f hex -r -q

    # Launch the clipboard manager
    bindsym $mod+c exec cliphist list -max-items 1000 -max-dedupe-search 100 | rofi -dmenu -i -theme ~/.config/rofi/clipboard.rasi -display-columns 2 | cliphist decode | wl-copy

    # Delete an entry from the clipboard manager
    bindsym $mod+Alt+c exec cliphist list -max-items 1000 -max-dedupe-search 100 | rofi -dmenu -i -theme ~/.config/rofi/clipboard.rasi -display-columns 2 | cliphist delete

#
# Screenshots
#
    # Screenshot active window
    bindsym print exec grimshot --notify --cursor savecopy active 
    # Snip a selection and pipe to swappy
    bindsym $mod+shift+s exec grimshot --notify --cursor savecopy area

