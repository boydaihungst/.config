exec /usr/libexec/xdg-desktop-portal-termfilechooser
exec /usr/local/libexec/file_manager_dbus
exec gpgconf --launch gpg-agent
exec sway-audio-idle-inhibit
exec ~/.config/sway/scripts/battery-watch.sh

