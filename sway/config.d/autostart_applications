exec --no-startup-id dbus-update-activation-environment --all
exec gnome-keyring-daemon --start --components=secrets
exec export $(gnome-keyring-daemon)
exec dex -a
#exec exec uwsm finalize DISPLAY WAYLAND_DISPLAY SWAYSOCK WLR_DRM_DEVICES WLR_RENDERER ENABLE_HDR_WSI I3SOCK XCURSOR_SIZE XCURSOR_THEME

# Idle configuration
exec swayidle -w \
    timeout 300 'brightnessctl -sd amdgpu_bl1 set 50%; brightnessctl -sd platform::kbd_backlight set 0' \
        resume 'brightnessctl -rd amdgpu_bl1; brightnessctl -rd platform::kbd_backlight' \
    timeout 600 'swaylock -f' \
    timeout 700 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
    # timeout 1800 'systemctl suspend-then-hibernate' \

