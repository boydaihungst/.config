
# (run via dex):
# Auth with polkit-gnome:
# exec /usr/libexec/polkit-gnome-authentication-agent-1

exec --no-startup-id dbus-update-activation-environment --all
# exec gnome-keyring-daemon --start --components=secrets
# exec export $(gnome-keyring-daemon)
exec dex-autostart -a

# Idle configuration
exec swayidle -w \
    timeout 150 'brightnessctl -s set 10; brightnessctl -sd platform::kbd_backlight set 0; /home/huyhoang/git/Monitor_Mode_AOC/monitor_mode -l 10' \
        resume 'brightnessctl -r; brightnessctl -rd platform::kbd_backlight; ddcutil --sn="AWBS39A000221" setvcp d6 1 && /home/huyhoang/git/Monitor_Mode_AOC/monitor_mode -l 100' \
    timeout 300 'swaylock -f' \
    timeout 360 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"; brightnessctl -r; brightnessctl -rd platform::kbd_backlight; ddcutil --sn="AWBS39A000221" setvcp d6 1 && /home/huyhoang/git/Monitor_Mode_AOC/monitor_mode -l 100' \
    before-sleep 'swaylock -f' \
    timeout 1800 'loginctl suspend'
    # timeout 1800 'systemctl suspend-then-hibernate'

# Autotiling
exec autotiling

# cliphist
exec wl-paste --watch cliphist store

# TODO: Check xdg-portal
# exec /usr/libexec/xdg-desktop-portal-termfilechooser
# exec /usr/local/libexec/file_manager_dbus
exec gpgconf --launch gpg-agent
exec ~/.config/sway/scripts/battery-watch.sh
exec_always swaybg -i ~/.config/sway/wallpaper -m fill
exec mpd --no-daemon ~/.config/mpd/mpd.conf
exec mpd-mpris -network unix  --host ~/.config/mpd/socket

exec_always shikane --config ~/.config/shikane/config_sway.toml
exec_always python3 ~/.config/sway/scripts/headless-ws.py
exec ddcutil --sn="AWBS39A000221" setvcp d6 1 && /home/huyhoang/git/Monitor_Mode_AOC/monitor_mode -l 100
# exec-once = waypaper-engine daemon

# exec-once = ibus start --type wayland
