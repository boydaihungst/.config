exec shikane

# (run via dex):
# Auth with polkit-gnome:
# exec /usr/libexec/polkit-gnome-authentication-agent-1

exec --no-startup-id dbus-update-activation-environment --all
exec gnome-keyring-daemon --start --components=secrets
exec export $(gnome-keyring-daemon)
exec dex -a

# Idle configuration
exec swayidle -w \
    timeout 300 'brightnessctl -s set 50%; brightnessctl -sd platform::kbd_backlight set 0' \
        resume 'brightnessctl -r; brightnessctl -rd platform::kbd_backlight' \
    timeout 600 'swaylock -f' \
    timeout 700 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
    # timeout 1800 'systemctl suspend-then-hibernate' \

#exec batsignal -b -a battery -I "battery-charged" -e -n BAT0 -w 15 -c 10 -d 5 -W "Battery is low" -C "Battery is low. System will shutdown soon" -D "systemctl hibernate"

# Autotiling
exec autotiling

# cliphist
exec wl-paste --watch cliphist store

# (run via dex):
