### Output configuration
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs
#
# You can also bind workspaces 1,2,3 to specific outputs
#
# workspace 1 output eDP-2
# workspace 2 output HDMI-A-1
# workspace 3 output DP-1
#
# Wacom Tablet - Example
#   input "1386:884:Wacom_Intuos_S_Pad" map_to_output HDMI-A-1
#   input "1386:884:Wacom_Intuos_S_Pen" map_to_output HDMI-A-1

#output eDP-1 pos 0 0 mode 2560x1600@240Hz scale 1.25 hdr on render_bit_depth 10 adaptive_sync on bg "~/.config/sway/wallpaper" fit
# output eDP-1 pos 0 0 mode 2560x1600@240Hz scale 1.25 adaptive_sync on render_bit_depth 10 color_profile icc "~/.config/sway/scripts/color_profiles/TPLCD_2039_Native.icm" bg "~/.config/sway/wallpaper" fit
# output HDMI-A-1 pos 0 0 mode 2560x1600@260Hz scale 1 adaptive_sync on render_bit_depth 10 color_profile icc "~/.config/sway/scripts/color_profiles/TPLCD_2039_Native.icm" bg "~/.config/sway/wallpaper" fit
# output DP-1 pos 0 0 mode 2560x1600@260Hz scale 1 adaptive_sync on render_bit_depth 10 color_profile icc "~/.config/sway/scripts/color_profiles/TPLCD_2039_Native.icm" bg "~/.config/sway/wallpaper" fit
# Assign workspaces to specific monitors
workspace 1 output eDP-1
workspace 2 output HDMI-A-1
workspace 3 output eDP-1
workspace 4 output HDMI-A-1
workspace 5 output HDMI-A-1
workspace 6 output HDMI-A-1
