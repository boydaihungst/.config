Dialogue: 0,0:00:30.32,0:00:32.41,Default,,0,0,0,,- Chào.\N- Ồ, Morimo.
Dialogue: 0,0:00:36.33,0:00:37.87,Default,,0,0,0,,- Chào buổi sáng.\N- Chào.
Dialogue: 0,0:00:37.87,0:00:39.75,Default,,0,0,0,,- Ồ, Mini.\N- Làm cái gì thế?
Dialogue: 0,0:00:39.75,0:00:41.21,Default,,0,0,0,,Đùa chút thôi.
Dialogue: 0,0:01:21.08,0:01:22.92,Default,,0,0,0,,Tani à, chào buổi sáng.
Dialogue: 0,0:01:26.00,0:01:28.25,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:01:28.25,0:01:29.42,Default,,0,0,0,,Tởm quá.
Dialogue: 0,0:01:29.42,0:01:30.50,Default,,0,0,0,,Lắm mồm quá đi!
Dialogue: 0,0:01:30.51,0:01:32.68,Default,,0,0,0,,Tránh ra! Đập xẹp búi tóc bây giờ.
Dialogue: 0,0:01:32.68,0:01:33.68,Default,,0,0,0,,Cấm động vào.
Dialogue: 0,0:01:33.68,0:01:36.43,Default,,0,0,0,,Hai đứa không nhanh lên là muộn học đấy.
Dialogue: 0,0:01:37.35,0:01:38.43,Default,,0,0,0,,Con đi đây.
Dialogue: 0,0:01:56.78,0:01:58.78,Default,,0,0,0,,Suzuki, chào buổi sáng.
Dialogue: 0,0:01:58.79,0:02:00.92,Default,,0,0,0,,Azuma, chào buổi sáng.\NTaira cũng đi cùng à?
Dialogue: 0,0:02:00.91,0:02:01.91,Default,,0,0,0,,Ai đi cùng chứ!
Dialogue: 0,0:02:01.91,0:02:03.70,Default,,0,0,0,,Chào buổi sáng, Nabe-Sato.
Dialogue: 0,0:02:03.71,0:02:04.92,Default,,0,0,0,,- Chào buổi sáng.\N- Chào buổi sáng.
Dialogue: 0,0:02:04.92,0:02:06.71,Default,,0,0,0,,Yamada, chào cậu.
Dialogue: 0,0:02:06.71,0:02:07.67,Default,,0,0,0,,Yo!
Dialogue: 0,0:02:07.67,0:02:10.84,Default,,0,0,0,,Ồ, T-Tani, chào buổi sáng.
Dialogue: 0,0:02:15.01,0:02:16.10,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,0:02:18.68,0:02:20.72,Default,,0,0,0,,Suzuki, giọng cậu to quá.
Dialogue: 0,0:02:20.72,0:02:22.68,Default,,0,0,0,,Chào hỏi là cách cứu rỗi thế giới mà!
Dialogue: 0,0:02:22.68,0:02:25.64,Default,,0,0,0,,Này, hôm nay lông mi tớ trông ổn không?
Dialogue: 0,0:02:26.40,0:02:27.73,Default,,0,0,0,,Chả biết nữa.
Dialogue: 0,0:02:28.31,0:02:29.48,Default,,0,0,0,,Hay đi nối mi luôn đi?
Dialogue: 0,0:02:30.07,0:02:32.61,Default,,0,0,0,,Tớ cũng nghĩ đến chuyện đó rồi.
Dialogue: 0,0:02:32.61,0:02:35.70,Default,,0,0,0,,Nhưng tớ muốn đẹp lên\Nbằng lông mi của chính mình cơ.
Dialogue: 0,0:02:35.70,0:02:40.87,Default,,0,0,0,,Cơ mà dùng mascara thì lúc đổ mồ hôi,\Nkhóc hay dụi mắt là trôi sạch.
Dialogue: 0,0:02:40.87,0:02:44.21,Default,,0,0,0,,Rốt cuộc là không biết\Nnên dùng hãng nào nữa.
Dialogue: 0,0:02:44.21,0:02:47.21,Default,,0,0,0,,Tớ cứ đắn đo hoài vậy đấy.
Dialogue: 0,0:02:47.21,0:02:48.92,Default,,0,0,0,,Tani, cậu nghĩ sao?
Dialogue: 0,0:02:51.05,0:02:52.89,Default,,0,0,0,,Sao mà tớ biết được.
Dialogue: 0,0:02:54.84,0:02:57.38,Default,,0,0,0,,Vẫn phũ phàng như mọi khi nhỉ.
Dialogue: 0,0:02:57.97,0:03:00.26,Default,,0,0,0,,Sao cứ ép Tani\Nphải trả lời mấy câu vô tri thế?
Dialogue: 0,0:03:00.26,0:03:03.01,Default,,0,0,0,,- Toàn là chủ đề cậu ấy không hứng thú.\N- Chuẩn đấy.
Dialogue: 0,0:03:03.52,0:03:07.52,Default,,0,0,0,,Tại cậu ấy lúc nào cũng trả lời phũ phàng\Nnên tớ lỡ miệng.
Dialogue: 0,0:03:08.19,0:03:11.15,Default,,0,0,0,,Lúc nào cần tư vấn chọn mascara\Nthì cứ hỏi tớ nhé.
Dialogue: 0,0:03:11.15,0:03:12.40,Default,,0,0,0,,Không cần.
Dialogue: 0,0:03:12.40,0:03:14.36,Default,,0,0,0,,Lại bị phũ rồi.
Dialogue: 0,0:03:14.36,0:03:15.78,Default,,0,0,0,,Phũ phàng thật.
Dialogue: 0,0:03:15.78,0:03:17.41,Default,,0,0,0,,Đừng làm khó cậu ấy nữa.
Dialogue: 0,0:03:22.74,0:03:26.70,Default,,0,0,0,,{\i1}Tani à. Xin lỗi cậu nhé.{\i0}
Dialogue: 0,0:03:27.42,0:03:28.96,Default,,0,0,0,,{\i1}Thực lòng thì…{\i0}
Dialogue: 0,0:03:30.29,0:03:32.29,Default,,0,0,0,,{\i1}tớ thích cậu lắm luôn!{\i0}
Dialogue: 0,0:03:33.00,0:03:38.13,Default,,0,0,0,,CẬU VÀ TỚ LÀ HAI THÁI CỰC ĐỐI LẬP
Dialogue: 0,0:03:45.43,0:03:50.14,Default,,0,0,0,,CẬU VÀ TỚ LÀ HAI THÁI CỰC ĐỐI LẬP
Dialogue: 0,0:05:05.01,0:05:06.68,Default,,0,0,0,,Làm bài tập tiếng Anh chưa?
Dialogue: 0,0:05:06.68,0:05:09.10,Default,,0,0,0,,Tớ làm mấy câu dễ bị gọi trúng thôi.
Dialogue: 0,0:05:09.10,0:05:10.52,Default,,0,0,0,,Phải làm hết đi chứ.
Dialogue: 0,0:05:11.10,0:05:13.02,Default,,0,0,0,,{\i1}Người ngồi cạnh tôi là Tani.{\i0}
Dialogue: 0,0:05:13.52,0:05:20.03,Default,,0,0,0,,{\i1}Có vẻ mọi người chỉ nghĩ Tani\Nlà một cậu bạn đeo kính, trầm tính thôi.{\i0}
Dialogue: 0,0:05:20.03,0:05:23.03,Default,,0,0,0,,{\an8}{\i1}Tani luôn nói thẳng quan điểm của mình.{\i0}
Dialogue: 0,0:05:23.03,0:05:24.03,Default,,0,0,0,,CHỈ THẲNG
Dialogue: 0,0:05:24.03,0:05:27.20,Default,,0,0,0,,Chỗ này dễ bị bắt bẻ lắm, cậu nên sửa đi.
Dialogue: 0,0:05:27.70,0:05:29.45,Default,,0,0,0,,Tại sao? Làm qua loa là được mà.
Dialogue: 0,0:05:30.04,0:05:33.04,Default,,0,0,0,,{\i1}Cậu ấy đối xử với mọi người như nhau.{\i0}
Dialogue: 0,0:05:33.04,0:05:33.91,Default,,0,0,0,,KHÔNG TỎ RA GAY GẮT
Dialogue: 0,0:05:33.92,0:05:34.76,Default,,0,0,0,,Nộp bài tập đi.
Dialogue: 0,0:05:35.75,0:05:36.67,Default,,0,0,0,,KHÔNG TỎ RA KHÚM NÚM
Dialogue: 0,0:05:36.67,0:05:39.13,Default,,0,0,0,,- Nộp bài.\N- Ồ, cảm ơn đã thu hộ.
Dialogue: 0,0:05:39.13,0:05:40.59,Default,,0,0,0,,Nhờ cậu nhé.
Dialogue: 0,0:05:41.30,0:05:43.59,Default,,0,0,0,,{\i1}Cả lần đổi chỗ ngồi trước cũng vậy.{\i0}
Dialogue: 0,0:05:44.59,0:05:46.72,Default,,0,0,0,,{\an8}Nào, chuyển chỗ ngồi thôi.
Dialogue: 0,0:05:53.69,0:05:56.36,Default,,0,0,0,,KỲ TÍCH
Dialogue: 0,0:05:57.77,0:06:00.90,Default,,0,0,0,,{\an8}{\i1}Được ngồi cạnh nè! Thôi xong, làm sao đây?{\i0}
Dialogue: 0,0:06:01.94,0:06:04.40,Default,,0,0,0,,{\an8}Có gì chiếu cố nhé, cậu bàn bên.
Dialogue: 0,0:06:04.41,0:06:05.41,Default,,0,0,0,,{\an8}CƯỜI GƯỢNG GẠO
Dialogue: 0,0:06:05.41,0:06:06.70,Default,,0,0,0,,{\an8}Mong được chiếu cố.
Dialogue: 0,0:06:06.70,0:06:08.87,Default,,0,0,0,,Ngồi bàn đầu tưởng là dễ nhìn bảng hơn…
Dialogue: 0,0:06:08.87,0:06:11.96,Default,,0,0,0,,nhưng thực ra lại hơi khó nhìn nhỉ?
Dialogue: 0,0:06:11.95,0:06:14.87,Default,,0,0,0,,Chỗ nào không thấy được thì cứ bảo tớ nhé.
Dialogue: 0,0:06:15.58,0:06:18.88,Default,,0,0,0,,- Chắc không sao đâu.\N- À, vậy hả?
Dialogue: 0,0:06:19.38,0:06:22.88,Default,,0,0,0,,{\i1}Tani không quá cố gắng\Nhùa theo người khác.{\i0}
Dialogue: 0,0:06:24.51,0:06:28.10,Default,,0,0,0,,{\i1}Mình cực kỳ ngưỡng mộ chỗ đó của cậu ấy.{\i0}
Dialogue: 0,0:06:28.10,0:06:30.39,Default,,0,0,0,,Suzuki thì sao? Cậu thích cái nào hơn?
Dialogue: 0,0:06:31.18,0:06:33.14,Default,,0,0,0,,- Xin lỗi, tớ không để ý.\N- Ơ hay!
Dialogue: 0,0:06:33.73,0:06:35.31,Default,,0,0,0,,Nhưng mà tớ thấy…
Dialogue: 0,0:06:35.31,0:06:39.48,Default,,0,0,0,,người khuấy động bầu không khí trực tiếp\Nngầu hơn là qua thu âm.
Dialogue: 0,0:06:39.48,0:06:40.98,Default,,0,0,0,,Nhỉ, Tani?
Dialogue: 0,0:06:40.98,0:06:42.56,Default,,0,0,0,,Chịu, sao tớ biết được.
Dialogue: 0,0:06:42.57,0:06:46.49,Default,,0,0,0,,Tani à, thấy Suzuki phiền quá\Nthì cứ nói thẳng đi.
Dialogue: 0,0:06:49.33,0:06:50.92,Default,,0,0,0,,Cũng không sao hết.
Dialogue: 0,0:06:52.75,0:06:54.88,Default,,0,0,0,,Thấy chưa, có làm sao đâu.
Dialogue: 0,0:06:54.87,0:06:57.41,Default,,0,0,0,,{\i1}Á, may quá đi.{\i0}
Dialogue: 0,0:06:58.13,0:06:59.76,Default,,0,0,0,,{\i1}Tani, xin lỗi nhé.{\i0}
Dialogue: 0,0:06:59.75,0:07:03.38,Default,,0,0,0,,{\i1}Tớ thực sự thích cậu và muốn\Nbắt chuyện bình thường lắm chứ.{\i0}
Dialogue: 0,0:07:03.88,0:07:06.30,Default,,0,0,0,,{\i1}Nhưng vì sợ bị mọi người để ý,{\i0}
Dialogue: 0,0:07:06.30,0:07:10.39,Default,,0,0,0,,{\i1}tớ chỉ có thể tiếp cận gián tiếp\Nđể không lộ ra việc thích cậu.{\i0}
Dialogue: 0,0:07:10.39,0:07:12.89,Default,,0,0,0,,{\i1}Dù rất ngưỡng mộ Tani,{\i0}
Dialogue: 0,0:07:12.89,0:07:16.89,Default,,0,0,0,,{\i1}nhưng mình lại là kiểu người\Nngược lại với cậu ấy.{\i0}
Dialogue: 0,0:07:17.94,0:07:20.36,Default,,0,0,0,,Được rồi, sau giờ học,\Ncả lũ đi Kinba (King of Burger) đi.
Dialogue: 0,0:07:20.36,0:07:21.95,Default,,0,0,0,,Cậu cũng đi phải không?
Dialogue: 0,0:07:23.03,0:07:25.03,Default,,0,0,0,,{\i1}Nhưng phải làm bài tập nữa.{\i0}
Dialogue: 0,0:07:25.03,0:07:27.45,Default,,0,0,0,,HÁO HỨC
Dialogue: 0,0:07:30.53,0:07:32.32,Default,,0,0,0,,Đi chứ, đi chứ!
Dialogue: 0,0:07:32.33,0:07:34.46,Default,,0,0,0,,{\an8}Yeah!
Dialogue: 0,0:07:35.50,0:07:38.29,Default,,0,0,0,,Suzuki, cho tớ chép bài tập đi.
Dialogue: 0,0:07:38.29,0:07:39.79,Default,,0,0,0,,Lại nữa à?
Dialogue: 0,0:07:39.79,0:07:40.92,Default,,0,0,0,,Cứu tớ đi mà!
Dialogue: 0,0:07:41.92,0:07:43.88,Default,,0,0,0,,{\an8}Thiệt tình, nể lắm mới cho đấy.
Dialogue: 0,0:07:43.88,0:07:45.09,Default,,0,0,0,,{\an8}Cảm ơn!
Dialogue: 0,0:07:45.76,0:07:48.89,Default,,0,0,0,,À, Suzuki!\NStory cậu đăng hôm qua buồn cười ghê.
Dialogue: 0,0:07:48.89,0:07:51.60,Default,,0,0,0,,Ồ, Suzuki, tớ follow cậu được không?
Dialogue: 0,0:07:52.18,0:07:54.26,Default,,0,0,0,,{\i1}Mình có đăng gì kỳ cục không nhỉ?{\i0}
Dialogue: 0,0:07:54.27,0:07:56.98,Default,,0,0,0,,Ừm, được chứ, được chứ.
Dialogue: 0,0:07:57.64,0:08:00.94,Default,,0,0,0,,Cơ mà, Tani thông minh thật đấy.
Dialogue: 0,0:08:02.82,0:08:04.61,Default,,0,0,0,,À, buổi làm việc nhóm hôm nay ấy à?
Dialogue: 0,0:08:04.61,0:08:06.82,Default,,0,0,0,,Nhắc mới nhớ,\Nhôm trước có thấy cậu ta đi học thêm.
Dialogue: 0,0:08:06.82,0:08:08.57,Default,,0,0,0,,Hả? Định vào Todai à?
Dialogue: 0,0:08:08.57,0:08:10.07,Default,,0,0,0,,Ai mà biết.
Dialogue: 0,0:08:10.07,0:08:12.20,Default,,0,0,0,,Công nhận giỏi thật đấy.
Dialogue: 0,0:08:12.20,0:08:15.24,Default,,0,0,0,,Đúng là sống ở thế giới\Nkhác hẳn tụi mình nhỉ.
Dialogue: 0,0:08:15.24,0:08:16.32,Default,,0,0,0,,Đừng gộp người khác vào.
Dialogue: 0,0:08:16.33,0:08:20.37,Default,,0,0,0,,Trong đám này thì Suzuki\Nlà người thân với Tani nhỉ?
Dialogue: 0,0:08:20.37,0:08:22.71,Default,,0,0,0,,Hả? Vậy sao?
Dialogue: 0,0:08:24.88,0:08:26.09,Default,,0,0,0,,Bẩn quá đấy.
Dialogue: 0,0:08:26.09,0:08:27.01,Default,,0,0,0,,Nãy giờ cậu có ổn không đấy?
Dialogue: 0,0:08:28.22,0:08:32.06,Default,,0,0,0,,À thì đang ở độ tuổi\Năn uống dễ bị sặc ấy mà.
Dialogue: 0,0:08:32.05,0:08:33.01,Default,,0,0,0,,Còn trẻ măng mà bày đặt.
Dialogue: 0,0:08:34.39,0:08:37.52,Default,,0,0,0,,Trong bảng xếp hạng diễn viên nam,\NSudaken lại giành quán quân kìa.
Dialogue: 0,0:08:38.31,0:08:40.39,Default,,0,0,0,,Con gái có vẻ thích\Nkiểu con trai nổi loạn nhỉ.
Dialogue: 0,0:08:40.39,0:08:43.18,Default,,0,0,0,,Ơ hay, nếu chọn bạn trai\Nthì ai chỉ thích kiểu Sudaken!
Dialogue: 0,0:08:43.19,0:08:45.53,Default,,0,0,0,,Suzuki lại lên cơn cuồng Sudaken rồi.
Dialogue: 0,0:08:48.82,0:08:51.78,Default,,0,0,0,,{\i1}Việc hùa theo đám đông\Ntưởng là vì người khác…{\i0}
Dialogue: 0,0:08:52.74,0:08:54.08,Default,,0,0,0,,{\i1}nhưng lại không phải.{\i0}
Dialogue: 0,0:08:55.49,0:08:57.87,Default,,0,0,0,,{\i1}Hoàn toàn là vì bản thân mình.{\i0}
Dialogue: 0,0:09:06.67,0:09:07.75,Default,,0,0,0,,{\i1}Vậy mà…{\i0}
Dialogue: 0,0:09:09.26,0:09:13.18,Default,,0,0,0,,{\i1}sao thỉnh thoảng lại thấy mệt mỏi thế nhỉ?{\i0}
Dialogue: 0,0:09:20.98,0:09:22.86,Default,,0,0,0,,{\i1}Về thôi nào.{\i0}
Dialogue: 0,0:09:33.99,0:09:37.03,Default,,0,0,0,,Á, Tani, giờ này mới về hả? Muộn phết nhỉ.
Dialogue: 0,0:09:37.03,0:09:39.95,Default,,0,0,0,,{\i1}Mặt mình vừa rồi chắc trông kinh lắm.{\i0}
Dialogue: 0,0:09:41.04,0:09:42.96,Default,,0,0,0,,Có mấy việc của ban cán sự nên tớ ở lại.
Dialogue: 0,0:09:43.62,0:09:46.41,Default,,0,0,0,,Nhà cậu đi hướng nào vậy?
Dialogue: 0,0:09:46.42,0:09:47.84,Default,,0,0,0,,Ra cổng rồi rẽ phải.
Dialogue: 0,0:09:48.38,0:09:49.30,Default,,0,0,0,,Giống tớ!
Dialogue: 0,0:09:49.30,0:09:51.47,Default,,0,0,0,,{\i1}Không có ai nhìn thấy cả.{\i0}
Dialogue: 0,0:09:54.05,0:09:54.97,Default,,0,0,0,,Tani à.
Dialogue: 0,0:09:56.47,0:09:57.56,Default,,0,0,0,,{\i1}Hồi hộp quá đi.{\i0}
Dialogue: 0,0:10:00.31,0:10:03.23,Default,,0,0,0,,Về cùng tớ một đoạn nhé?
Dialogue: 0,0:10:03.85,0:10:06.10,Default,,0,0,0,,{\i1}Tim như muốn rớt ra ngoài!{\i0}
Dialogue: 0,0:10:08.27,0:10:10.73,Default,,0,0,0,,Tani cũng ở hướng này nhỉ.
Dialogue: 0,0:10:10.74,0:10:12.99,Default,,0,0,0,,Tớ đi về chưa bao giờ thấy cậu cả.
Dialogue: 0,0:10:14.03,0:10:14.86,Default,,0,0,0,,Ừ.
Dialogue: 0,0:10:21.12,0:10:25.75,Default,,0,0,0,,À, tại tớ toàn đi chơi\Nsau giờ học nên không gặp là phải.
Dialogue: 0,0:10:25.75,0:10:28.38,Default,,0,0,0,,Cậu còn bận việc ủy ban này nọ nữa.
Dialogue: 0,0:10:29.96,0:10:30.84,Default,,0,0,0,,Ừ.
Dialogue: 0,0:10:39.72,0:10:43.06,Default,,0,0,0,,À, đúng rồi, hôm nọ tớ vừa đi ăn Kinba.
Dialogue: 0,0:10:43.06,0:10:46.81,Default,,0,0,0,,Nhân nhiều kinh khủng,\Nbánh kẹp không hết luôn.
Dialogue: 0,0:10:46.81,0:10:52.11,Default,,0,0,0,,Bánh mì như chỉ để làm cảnh thôi ấy,\Nchả biết ăn kiểu gì luôn.
Dialogue: 0,0:10:53.32,0:10:55.07,Default,,0,0,0,,{\i1}Khoan, chuyện này có gì vui không?{\i0}
Dialogue: 0,0:10:55.57,0:10:56.66,Default,,0,0,0,,Ngon lắm hả?
Dialogue: 0,0:10:58.37,0:11:00.62,Default,,0,0,0,,Ừ, ngon, cực kỳ ngon luôn!
Dialogue: 0,0:11:00.62,0:11:03.33,Default,,0,0,0,,À, đúng rồi. Hôm nay đi ăn cùng không?
Dialogue: 0,0:11:03.33,0:11:04.67,Default,,0,0,0,,Đùa thôi.
Dialogue: 0,0:11:05.29,0:11:06.17,Default,,0,0,0,,Cũng được.
Dialogue: 0,0:11:08.42,0:11:09.55,Default,,0,0,0,,Hả?
Dialogue: 0,0:11:10.42,0:11:11.63,Default,,0,0,0,,{\i1}Cậu ấy vừa nói gì cơ?{\i0}
Dialogue: 0,0:11:12.13,0:11:15.30,Default,,0,0,0,,{\i1}Đáp lại xã giao hả? Hùa theo hả?{\i0}
Dialogue: 0,0:11:18.64,0:11:21.81,Default,,0,0,0,,{\i1}Không, Tani đâu phải người như thế.{\i0}
Dialogue: 0,0:11:30.15,0:11:31.53,Default,,0,0,0,,{\i1}Nói gì đi.{\i0}
Dialogue: 0,0:11:31.52,0:11:34.02,Default,,0,0,0,,{\i1}Nói gì lại đi chứ, tôi ơi!{\i0}
Dialogue: 0,0:11:34.53,0:11:35.78,Default,,0,0,0,,{\i1}Không được rồi.{\i0}
Dialogue: 0,0:11:35.78,0:11:39.28,Default,,0,0,0,,{\an8}{\i1}Tim đập nhanh quá, chịu không nổi!{\i0}
Dialogue: 0,0:11:39.28,0:11:40.53,Default,,0,0,0,,CỘC
Dialogue: 0,0:11:40.53,0:11:42.16,Default,,0,0,0,,GIẬT MÌNH
Dialogue: 0,0:11:42.74,0:11:44.41,Default,,0,0,0,,À… thì…
Dialogue: 0,0:12:18.57,0:12:19.74,Default,,0,0,0,,{\i1}Không thể nào.{\i0}
Dialogue: 0,0:12:21.37,0:12:22.54,Default,,0,0,0,,{\i1}Chuyện gì thế này?{\i0}
Dialogue: 0,0:12:23.16,0:12:24.20,Default,,0,0,0,,{\i1}Là mơ à?{\i0}
Dialogue: 0,0:12:26.83,0:12:30.04,Default,,0,0,0,,{\i1}Làm sao đây? Chắc chắn lúc này…{\i0}
Dialogue: 0,0:12:30.83,0:12:32.96,Default,,0,0,0,,{\i1}tay mình đầm đìa mồ hôi.{\i0}
Dialogue: 0,0:12:35.30,0:12:39.39,Default,,0,0,0,,{\i1}Tiếng tim đập to quá, đến mức\Nsau tai cũng nghe thấy tiếng mạch đập.{\i0}
Dialogue: 0,0:12:39.38,0:12:40.34,Default,,0,0,0,,{\i1}Sắp ngỏm chăng?{\i0}
Dialogue: 0,0:12:40.84,0:12:44.38,Default,,0,0,0,,Mà tóc mái của Harasen\Ntrông ố dề thật đấy.
Dialogue: 0,0:12:44.39,0:12:46.27,Default,,0,0,0,,Trông xấu thật đấy.
Dialogue: 0,0:12:53.86,0:12:54.65,Default,,0,0,0,,{\an8}CHẮC LÀ ĐÃ NÓI CHUYỆN NHƯ VẬY
Dialogue: 0,0:12:54.65,0:12:55.82,Default,,0,0,0,,{\an8}{\i1}Từ lúc đó…{\i0}
Dialogue: 0,0:12:55.82,0:12:56.74,Default,,0,0,0,,{\an8}NHÀ TỚ BÊN NÀY - NHÀ TỚ THÌ BÊN KIA
Dialogue: 0,0:12:56.73,0:12:58.90,Default,,0,0,0,,{\an8}{\i1}mình không nhớ đã về nhà như thế nào nữa.{\i0}
Dialogue: 0,0:13:03.82,0:13:05.28,Default,,0,0,0,,Về rồi… Hả?!
Dialogue: 0,0:13:05.28,0:13:06.53,Default,,0,0,0,,Đừng có nằm ở lối ra chứ!
Dialogue: 0,0:13:06.54,0:13:07.46,Default,,0,0,0,,CHÁN NẢN
Dialogue: 0,0:13:07.45,0:13:09.37,Default,,0,0,0,,À, anh hai à.
Dialogue: 0,0:13:11.96,0:13:13.21,Default,,0,0,0,,Á Á Á! ĐẠP CHÂN LIÊN HỒI!
Dialogue: 0,0:13:13.21,0:13:14.38,Default,,0,0,0,,{\i1}Ghê quá.{\i0}
Dialogue: 0,0:13:16.21,0:13:19.13,Default,,0,0,0,,{\i1}Nắm tay… rồi sao?{\i0}
Dialogue: 0,0:13:19.13,0:13:20.51,Default,,0,0,0,,Không ăn hả?
Dialogue: 0,0:13:20.51,0:13:22.14,Default,,0,0,0,,Không ăn thì đưa đây.
Dialogue: 0,0:13:23.18,0:13:24.64,Default,,0,0,0,,{\i1}Chưa kể…{\i0}
Dialogue: 0,0:13:25.22,0:13:26.72,Default,,0,0,0,,{\i1}là cậu ấy chủ động.{\i0}
Dialogue: 0,0:13:26.72,0:13:29.31,Default,,0,0,0,,{\i1}Thôi xong, thôi xong,\Nthôi xong, thôi xong!{\i0}
Dialogue: 0,0:13:29.31,0:13:32.48,Default,,0,0,0,,{\i1}Ngày mai biết vác mặt nào đến trường đây?{\i0}
Dialogue: 0,0:13:32.48,0:13:36.65,Default,,0,0,0,,{\an8}{\i1}Hồi hộp thế này thì sao ngủ được chứ!{\i0}
Dialogue: 0,0:13:37.57,0:13:40.53,Default,,0,0,0,,Á Á Á
Dialogue: 0,0:13:40.53,0:13:42.28,Default,,0,0,0,,Im mồm!
Dialogue: 0,0:13:42.99,0:13:45.54,Default,,0,0,0,,KHÒ
Dialogue: 0,0:13:54.63,0:13:55.46,Default,,0,0,0,,{\an8}Ngã mất tiêu.
Dialogue: 0,0:13:56.04,0:13:58.12,Default,,0,0,0,,Ui da!
Dialogue: 0,0:13:58.13,0:14:00.47,Default,,0,0,0,,Ủa, sáng rồi, không thể nào.
Dialogue: 0,0:14:00.46,0:14:01.71,Default,,0,0,0,,Mà mấy giờ rồi?
Dialogue: 0,0:14:07.05,0:14:07.97,Default,,0,0,0,,{\an8}VỘI VỘI VÀNG VÀNG
Dialogue: 0,0:14:07.97,0:14:09.97,Default,,0,0,0,,{\an8}Mình chưa đi muộn hay nghỉ buổi nào hết!
Dialogue: 0,0:14:10.93,0:14:12.89,Default,,0,0,0,,Sao lại thế? Cả nhà đâu rồi?
Dialogue: 0,0:14:12.89,0:14:14.31,Default,,0,0,0,,CẢ NHÀ: ANH HAI - MẸ - BỐ
Dialogue: 0,0:14:14.31,0:14:15.98,Default,,0,0,0,,LÂU LÂU DẬY MUỘN CŨNG ĐƯỢC\NNHƯNG NHỚ ĂN SÁNG ĐẤY - MẸ
Dialogue: 0,0:14:15.98,0:14:18.23,Default,,0,0,0,,Trời ơi.
Dialogue: 0,0:14:18.90,0:14:20.99,Default,,0,0,0,,Cơ mà ăn sáng gì nữa, đến trưa rồi.
Dialogue: 0,0:14:22.03,0:14:22.95,Default,,0,0,0,,{\an8}MUỘN QUÁ THÀNH RA BÌNH TĨNH LẠ THƯỜNG
Dialogue: 0,0:14:22.95,0:14:24.99,Default,,0,0,0,,{\an8}Có cuống lên cũng chả để làm gì.
Dialogue: 0,0:14:26.24,0:14:27.24,Default,,0,0,0,,Bắn lại nào.
Dialogue: 0,0:14:30.49,0:14:32.62,Default,,0,0,0,,Tuy đến giờ nghỉ trưa rồi\Nnhưng chào buổi sáng.
Dialogue: 0,0:14:32.62,0:14:34.33,Default,,0,0,0,,Hiếm khi thấy cậu đến muộn nhỉ.
Dialogue: 0,0:14:34.33,0:14:36.67,Default,,0,0,0,,Sao không nghỉ luôn đi?
Dialogue: 0,0:14:36.67,0:14:39.05,Default,,0,0,0,,Môn thể dục tự chọn thì phải đi chứ.
Dialogue: 0,0:14:39.04,0:14:40.00,Default,,0,0,0,,Ngốc thật đấy.
Dialogue: 0,0:14:43.30,0:14:45.01,Default,,0,0,0,,Ồ, Suzuki đến rồi kìa.
Dialogue: 0,0:14:45.01,0:14:46.14,Default,,0,0,0,,Ừm, chào.
Dialogue: 0,0:14:46.89,0:14:50.77,Default,,0,0,0,,Này, cậu đang… hẹn hò với Tani hả?
Dialogue: 0,0:14:51.68,0:14:52.60,Default,,0,0,0,,{\an8}{\i1}Hả?{\i0}
Dialogue: 0,0:14:53.48,0:14:57.57,Default,,0,0,0,,Gapacho kể là hôm qua\Nthấy hai cậu đi về cùng nhau.
Dialogue: 0,0:14:57.56,0:14:58.85,Default,,0,0,0,,{\i1}Gapacho là đứa nào?{\i0}
Dialogue: 0,0:14:58.86,0:15:00.69,Default,,0,0,0,,Chắc là nhìn nhầm thôi.
Dialogue: 0,0:15:00.69,0:15:02.23,Default,,0,0,0,,Đừng coi thường thị lực của Gapacho!
Dialogue: 0,0:15:02.23,0:15:03.40,Default,,0,0,0,,Ai mà biết được.
Dialogue: 0,0:15:04.07,0:15:06.16,Default,,0,0,0,,{\i1}Này này này, chờ đã Yamada.{\i0}
Dialogue: 0,0:15:06.82,0:15:11.91,Default,,0,0,0,,{\i1}Tuy có thể là lưỡng tình tương duyên\Nnhưng vẫn chưa có gì xác định cả,{\i0}
Dialogue: 0,0:15:11.91,0:15:13.99,Default,,0,0,0,,{\i1}là giai đoạn nhạy cảm nhất đấy!{\i0}
Dialogue: 0,0:15:14.00,0:15:16.71,Default,,0,0,0,,{\i1}Không phải chuyện\Ncó thể đem ra chọc cho vui đâu!{\i0}
Dialogue: 0,0:15:16.71,0:15:18.42,Default,,0,0,0,,{\i1}Tớ đang nghiêm túc đấy!{\i0}
Dialogue: 0,0:15:19.92,0:15:21.42,Default,,0,0,0,,{\i1}Cơ mà…{\i0}
Dialogue: 0,0:15:22.25,0:15:24.17,Default,,0,0,0,,{\i1}bảo là bị nhìn thấy…{\i0}
Dialogue: 0,0:15:24.88,0:15:26.13,Default,,0,0,0,,{\i1}nhưng ở đâu cơ?{\i0}
Dialogue: 0,0:15:29.68,0:15:31.18,Default,,0,0,0,,À thì…
Dialogue: 0,0:15:37.77,0:15:39.52,Default,,0,0,0,,làm gì có chuyện đó!
Dialogue: 0,0:15:40.31,0:15:41.39,Default,,0,0,0,,Này cậu…
Dialogue: 0,0:15:42.98,0:15:45.32,Default,,0,0,0,,đó là chỗ của tớ.
Dialogue: 0,0:15:48.49,0:15:49.57,Default,,0,0,0,,Lấy vở được không?
Dialogue: 0,0:15:49.57,0:15:51.66,Default,,0,0,0,,Hả? Ồ, xin lỗi, để đổi chỗ.
Dialogue: 0,0:15:51.66,0:15:53.87,Default,,0,0,0,,Không sao đâu,\Ntiết sau lại đổi phòng học mà.
Dialogue: 0,0:16:05.21,0:16:07.00,Default,,0,0,0,,{\i1}Không thể nào tệ hơn.{\i0}
Dialogue: 0,0:16:09.68,0:16:12.18,Default,,0,0,0,,Đường sẽ bị phân giải trong cơ thể,
Dialogue: 0,0:16:12.18,0:16:14.39,Default,,0,0,0,,dẫn đến tăng đường huyết sau ăn.
Dialogue: 0,0:16:14.39,0:16:17.68,Default,,0,0,0,,{\i1}Cậu ấy đã nghe thấy đoạn\Nmình phủ nhận kịch liệt.{\i0}
Dialogue: 0,0:16:17.69,0:16:19.61,Default,,0,0,0,,{\i1}Còn gì quá đáng hơn thế.{\i0}
Dialogue: 0,0:16:21.11,0:16:24.07,Default,,0,0,0,,Không phải đâu, tớ không có ý đó đâu!
Dialogue: 0,0:16:24.07,0:16:25.36,Default,,0,0,0,,Tani, xin lỗi cậu!
Dialogue: 0,0:16:29.45,0:16:31.24,Default,,0,0,0,,{\an8}{\i1}Không được, không được,\Nkhông làm thế được!{\i0}
Dialogue: 0,0:16:31.24,0:16:33.49,Default,,0,0,0,,{\an8}{\i1}Nhưng mình muốn xin lỗi ngay!{\i0}
Dialogue: 0,0:16:35.33,0:16:37.08,Default,,0,0,0,,{\an8}{\i1}Làm sao đây?{\i0}
Dialogue: 0,0:16:37.08,0:16:40.21,Default,,0,0,0,,{\an8}{\i1}Cậu ấy có bị khó chịu không nhỉ?{\i0}
Dialogue: 0,0:16:40.21,0:16:41.13,Default,,0,0,0,,{\an8}{\i1}Không ổn rồi.{\i0}
Dialogue: 0,0:16:41.13,0:16:43.97,Default,,0,0,0,,{\an8}Suzuki chẳng đỡ được quả nào hết kìa.
Dialogue: 0,0:16:43.96,0:16:45.21,Default,,0,0,0,,Dùng tay bắt luôn cho rồi.
Dialogue: 0,0:16:45.21,0:16:47.67,Default,,0,0,0,,{\an8}SUY SỤP
Dialogue: 0,0:16:47.67,0:16:50.38,Default,,0,0,0,,{\an8}{\i1}Sao mình lại nói vậy cơ chứ!{\i0}
Dialogue: 0,0:16:51.68,0:16:53.22,Default,,0,0,0,,Suzuki, xin lỗi nhé.
Dialogue: 0,0:16:58.81,0:17:01.94,Default,,0,0,0,,{\i1}Bắt chuyện nào, phải bắt chuyện bằng được.{\i0}
Dialogue: 0,0:17:01.94,0:17:03.73,Default,,0,0,0,,{\i1}Phải mau giải quyết hiểu lầm.{\i0}
Dialogue: 0,0:17:03.73,0:17:04.65,Default,,0,0,0,,RUN RUN
Dialogue: 0,0:17:05.48,0:17:07.15,Default,,0,0,0,,{\i1}Nhưng sao nói được…{\i0}
Dialogue: 0,0:17:08.32,0:17:10.49,Default,,0,0,0,,{\an8}{\i1}trước mặt mọi người thế này.{\i0}
Dialogue: 0,0:17:16.24,0:17:17.49,Default,,0,0,0,,- Suzuki à.\N- Hả?
Dialogue: 0,0:17:17.49,0:17:18.41,Default,,0,0,0,,THÌNH THỊCH
Dialogue: 0,0:17:19.12,0:17:20.50,Default,,0,0,0,,T-Tani…
Dialogue: 0,0:17:24.00,0:17:26.13,Default,,0,0,0,,Hãy quên vụ hôm qua đi nhé.
Dialogue: 0,0:17:27.71,0:17:28.59,Default,,0,0,0,,Xin lỗi.
Dialogue: 0,0:17:43.40,0:17:47.15,Default,,0,0,0,,Suzuki, phiếu giảm giá bắp rang\Nhôm nay hết hạn nè, đi thôi!
Dialogue: 0,0:17:47.15,0:17:50.15,Default,,0,0,0,,{\an8}Mà này,\Nlúc nãy cậu vừa nói chuyện với Tani hả?
Dialogue: 0,0:17:50.15,0:17:51.78,Default,,0,0,0,,{\an8}Thân thiết thế còn gì.
Dialogue: 0,0:17:52.91,0:17:54.08,Default,,0,0,0,,{\an8}Suzuki?
Dialogue: 0,0:17:54.66,0:17:55.66,Default,,0,0,0,,Có thể lắm.
Dialogue: 0,0:17:55.66,0:17:57.08,Default,,0,0,0,,- Buồn cười thật\N- Nói lại đi.
Dialogue: 0,0:18:04.92,0:18:05.92,Default,,0,0,0,,Tớ…
Dialogue: 0,0:18:06.42,0:18:09.46,Default,,0,0,0,,thích Tani.
Dialogue: 0,0:18:09.46,0:18:10.29,Default,,0,0,0,,Hả?
Dialogue: 0,0:18:10.92,0:18:12.67,Default,,0,0,0,,Là tớ yêu đơn phương.
Dialogue: 0,0:18:13.43,0:18:14.35,Default,,0,0,0,,Hả?
Dialogue: 0,0:18:14.97,0:18:20.60,Default,,0,0,0,,Và… hôm qua,\Ntớ là người đã rủ cậu ấy cùng về.
Dialogue: 0,0:18:21.56,0:18:24.86,Default,,0,0,0,,Vậy thì… có gì kỳ chứ?
Dialogue: 0,0:18:27.06,0:18:28.23,Default,,0,0,0,,Hả?
Dialogue: 0,0:18:28.23,0:18:30.36,Default,,0,0,0,,Thế thì phải nói ra chứ!
Dialogue: 0,0:18:30.36,0:18:33.11,Default,,0,0,0,,Còn tưởng cả hai tình cờ đi về cùng nhau.
Dialogue: 0,0:18:33.11,0:18:36.36,Default,,0,0,0,,Ai mà nghĩ là hẹn hò thật!
Dialogue: 0,0:18:36.37,0:18:37.58,Default,,0,0,0,,Ủa? Mà khoan.
Dialogue: 0,0:18:37.57,0:18:38.49,Default,,0,0,0,,{\an8}THÔI XONG
Dialogue: 0,0:18:38.49,0:18:41.66,Default,,0,0,0,,{\an8}Lúc nghỉ trưa,\Ntớ nói mấy câu siêu vô duyên thì phải?
Dialogue: 0,0:18:41.66,0:18:43.37,Default,,0,0,0,,{\an8}Lúc nào cậu chẳng vô duyên.
Dialogue: 0,0:18:44.29,0:18:47.25,Default,,0,0,0,,Thế Tani về mất rồi, có ổn không đấy?
Dialogue: 0,0:18:47.25,0:18:48.21,Default,,0,0,0,,Không ổn chút nào.
Dialogue: 0,0:18:48.21,0:18:50.04,Default,,0,0,0,,Chạy thì đuổi kịp đấy.
Dialogue: 0,0:18:50.05,0:18:51.89,Default,,0,0,0,,Lớn chuyện rồi Suzuki, mau chạy đi!
Dialogue: 0,0:18:54.59,0:18:57.68,Default,,0,0,0,,Không cần bận tâm vụ bắp rang đâu nhé.
Dialogue: 0,0:18:57.68,0:18:59.52,Default,,0,0,0,,- Xin lỗi, không bận tâm chút nào đâu.\N- Ơ hay!
Dialogue: 0,0:19:01.60,0:19:05.02,Default,,0,0,0,,Chạy đi, Suzuki!\NChạy nhanh như cái tên của cậu đi!
Dialogue: 0,0:19:05.02,0:19:07.06,Default,,0,0,0,,Suzuki có khác!
Dialogue: 0,0:19:07.98,0:19:09.36,Default,,0,0,0,,Tới đây!
Dialogue: 0,0:19:09.36,0:19:10.40,Default,,0,0,0,,{\an8}LẠCH BẠCH - LẠCH BẠCH
Dialogue: 0,0:19:10.40,0:19:11.73,Default,,0,0,0,,{\an8}Trời ạ, chậm rì.
Dialogue: 0,0:19:13.36,0:19:15.86,Default,,0,0,0,,- Tới luôn đi!\N- Nhìn về phía trước.
Dialogue: 0,0:19:15.86,0:19:17.86,Default,,0,0,0,,Chạy đi.
Dialogue: 0,0:19:20.62,0:19:22.00,Default,,0,0,0,,{\i1}Tưởng gì.{\i0}
Dialogue: 0,0:19:24.41,0:19:29.87,Default,,0,0,0,,{\i1}Nói ra cảm xúc thật của mình\Nđơn giản đến vậy sao?{\i0}
Dialogue: 0,0:19:42.64,0:19:43.89,Default,,0,0,0,,{\an8}{\i1}Chỉ có thể nói…{\i0}
Dialogue: 0,0:19:43.89,0:19:44.81,Default,,0,0,0,,{\an8}HỐI KHÔNG KỊP NỮA RỒI
Dialogue: 0,0:19:44.81,0:19:46.56,Default,,0,0,0,,{\an8}{\i1}đó là một phút yếu lòng thôi.{\i0}
Dialogue: 0,0:19:47.14,0:19:51.48,Default,,0,0,0,,{\i1}Suzuki ngồi bàn bên lúc nào\Ncũng chủ động bắt chuyện với mình.{\i0}
Dialogue: 0,0:19:51.48,0:19:56.07,Default,,0,0,0,,{\i1}Là vì cậu ấy không có tình cảm với mình\Nnên mới nói chuyện thoải mái thế.{\i0}
Dialogue: 0,0:19:58.49,0:20:01.29,Default,,0,0,0,,Về cùng tớ một đoạn nhé?
Dialogue: 0,0:20:01.78,0:20:04.07,Default,,0,0,0,,{\i1}Mình đã luôn nghĩ như vậy.{\i0}
Dialogue: 0,0:20:18.80,0:20:21.85,Default,,0,0,0,,{\i1}Hôm nay còn tưởng cậu ấy không đến trường.{\i0}
Dialogue: 0,0:20:22.43,0:20:24.35,Default,,0,0,0,,Làm gì có chuyện đó!
Dialogue: 0,0:20:26.56,0:20:28.06,Default,,0,0,0,,{\i1}Từ lúc nào không hay,{\i0}
Dialogue: 0,0:20:28.06,0:20:31.10,Default,,0,0,0,,{\i1}việc được Suzuki bắt chuyện\Nđã trở thành chuyện thường ngày.{\i0}
Dialogue: 0,0:20:32.94,0:20:35.19,Default,,0,0,0,,{\i1}Một ngày không có cậu ấy…{\i0}
Dialogue: 0,0:20:35.19,0:20:36.44,Default,,0,0,0,,Tani à!
Dialogue: 0,0:20:36.44,0:20:38.57,Default,,0,0,0,,{\i1}thật quá đỗi yên tĩnh.{\i0}
Dialogue: 0,0:20:38.57,0:20:43.62,Default,,0,0,0,,Tớ thích cậu!
Dialogue: 0,0:20:51.33,0:20:52.96,Default,,0,0,0,,T-Tani.
Dialogue: 0,0:20:52.96,0:20:57.13,Default,,0,0,0,,Xin lỗi vì lúc nào cũng kiếm chuyện\Nlàm phiền cậu như thế!
Dialogue: 0,0:20:57.80,0:21:01.72,Default,,0,0,0,,Xin lỗi vì đã nói về cậu như thế\Ntrước mặt mọi người.
Dialogue: 0,0:21:01.72,0:21:05.22,Default,,0,0,0,,Tớ không biết làm thế nào\Nđể nói chuyện với cậu nữa.
Dialogue: 0,0:21:06.77,0:21:10.73,Default,,0,0,0,,Tớ sợ mọi người biết tình cảm của mình.
Dialogue: 0,0:21:12.48,0:21:15.48,Default,,0,0,0,,Tớ là một đứa cực kỳ hèn nhát.
Dialogue: 0,0:21:16.48,0:21:17.48,Default,,0,0,0,,Nhưng mà…
Dialogue: 0,0:21:17.48,0:21:21.48,Default,,0,0,0,,tớ muốn… ở bên cậu nhiều hơn nữa!
Dialogue: 0,0:21:23.49,0:21:27.83,Default,,0,0,0,,Tớ rất vui vì được cậu nắm tay.
Dialogue: 0,0:21:27.83,0:21:31.50,Default,,0,0,0,,Vui đến mức thao thức cả đêm\Nrồi ngủ quên mất tiêu.
Dialogue: 0,0:21:31.50,0:21:34.17,Default,,0,0,0,,Chắc cậu sẽ nghĩ\N"Ơ, hóa ra vẫn lăn ra ngủ à?".
Dialogue: 0,0:21:39.84,0:21:40.67,Default,,0,0,0,,Suzuki.
Dialogue: 0,0:21:42.09,0:21:43.17,Default,,0,0,0,,Tớ…
Dialogue: 0,0:21:44.30,0:21:49.01,Default,,0,0,0,,là đứa kém cỏi đến mức\Nnếu cậu ngừng bắt chuyện…
Dialogue: 0,0:21:49.73,0:21:53.28,Default,,0,0,0,,thì chẳng biết phải làm gì\Nđể lấp đầy khoảng lặng.
Dialogue: 0,0:21:55.69,0:21:58.48,Default,,0,0,0,,Dù vậy… cũng được sao?
Dialogue: 0,0:22:02.03,0:22:04.91,Default,,0,0,0,,Vẻ mặt vừa rồi đáng yêu quá đi!
Dialogue: 0,0:22:04.91,0:22:05.99,Default,,0,0,0,,Khoan đã.
Dialogue: 0,0:22:05.99,0:22:07.78,Default,,0,0,0,,Thì tất nhiên…
Dialogue: 0,0:22:07.78,0:22:11.20,Default,,0,0,0,,là được chứ sao!
Dialogue: 0,0:22:11.20,0:22:12.70,Default,,0,0,0,,KHÓC NỨC NỞ
Dialogue: 0,0:22:13.62,0:22:16.91,Default,,0,0,0,,Cứ như tớ làm cậu khóc vậy.
Dialogue: 0,0:22:16.92,0:22:18.71,Default,,0,0,0,,Thì thực chất đúng là vậy mà.
Dialogue: 0,0:22:21.63,0:22:24.97,Default,,0,0,0,,Mascara… bị trôi mất thì phải?
Dialogue: 0,0:22:27.05,0:22:30.89,Default,,0,0,0,,{\an8}Vậy là có để tâm tớ nói gì đấy thôi!
Dialogue: 0,0:22:30.89,0:22:34.39,Default,,0,0,0,,{\an8}- Nguy quá! Đốn tim mất thôi!\N- Hả? Tại sao?
Dialogue: 0,0:22:34.39,0:22:35.35,Default,,0,0,0,,{\an8}Sao lại vậy?
Dialogue: 0,0:22:35.35,0:22:36.89,Default,,0,0,0,,{\an8}Trời ạ!
Dialogue: 0,0:22:36.90,0:22:37.98,Default,,0,0,0,,{\an8}HẸN GẶP LẠI Ở TẬP SAU…
