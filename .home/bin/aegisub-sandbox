#!/bin/bash
exec bwrap \
  --bind / / \
  --ro-bind "$HOME/.config/aegisub/fontconfig/fonts.conf" /etc/fonts/fonts.conf \
  --ro-bind "$HOME/.local/share/vietnamese-font" /usr/share/fonts \
  --bind "$HOME/.local/aegisub-fontcache" /tmp/aegisub-fontcache \
  --dev-bind /dev /dev \
  --proc /proc \
  --setenv HOME "$HOME" \
  --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" \
  --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
  --setenv DISPLAY "$DISPLAY" \
  --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus" \
  --setenv PULSE_SERVER "unix:$XDG_RUNTIME_DIR/pulse/native" \
  --bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR" \
  /usr/bin/aegisub "$@"
